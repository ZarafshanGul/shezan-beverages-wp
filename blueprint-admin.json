{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/tools.php?page=sz-care",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/YOUR-USERNAME/shezan-beverages-wp",
        "ref": "main",
        "path": "shezan-theme"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Shezan Beverages (portfolio demo)",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; flush_rewrite_rules();"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
  ]
}